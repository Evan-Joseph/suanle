# 主大模型服务商配置 (默认高速线路 + 容灾备份线路)
LLM_BASE_URL="https://www.jiji.cc/v1"
LLM_BACKUP_BASES="https://api.jiji.cc/v1,https://api-slb.jiji.cc/v1"
LLM_API_KEY="sk-your-primary-api-key-here"
LLM_MODEL="gemini-4-argon"
LLM_LIGHT_MODEL="gemini-3.8-flash"
LLM_FALLBACK_MODELS="gemini-3.8-flash,gemini-3.7-flash,gemini-2.5-flash"

# 备用大模型服务商配置 (异地容灾兜底)
LLM_SECONDARY_BASE_URL="https://api.ai-pixel.online/v1"
LLM_SECONDARY_API_KEY="sk-your-secondary-api-key-here"

# 数据库配置 (可选，留空则自动降级为全功能本地内存持久化模式)
# DATABASE_URL="postgresql://suanle:password@db:5432/suanle"

# 赞赏与打赏跳转地址
NEXT_PUBLIC_TIP_URL="https://github.com/Evan-Joseph/suanle"
