{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:video": "remotion render src/video/index.ts MainPromo out/suanle_brand_promo.mp4 --codec h264 --crf 16",
    "build:video:60": "remotion render src/video/index.ts MainPromo60 out/suanle_brand_promo_60fps.mp4 --codec h264 --crf 16",
    "build:video:4k": "remotion render src/video/index.ts MainPromo60 out/suanle_brand_promo_4k60.mp4 --codec h264 --crf 16 --scale 2",
    "video:studio": "remotion studio src/video/index.ts",
    "video:still": "remotion still src/video/index.ts MainPromo out/still.png --frame",
    "video:sheet": "remotion still src/video/index.ts ContactSheet out/contact_sheet.png"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.536",
    "@remotion/fonts": "^4.0.536",
    "@remotion/noise": "^4.0.536",
    "@remotion/player": "^4.0.536",
    "@remotion/shapes": "^4.0.536",
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "remotion": "^4.0.536",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
