# ─── 数据库（只记录匿名计数、随喜订单与算力账本，不存任何对话内容）───
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ─── 推演引擎：任意 OpenAI 兼容接口 ───
# 未配置 LLM_API_KEY 时，应用自动使用内置的本地陪伴逻辑，体验不中断
LLM_BASE_URL=https://api.ai-pixel.online/v1
LLM_API_KEY=
LLM_MODEL=gemini-4-argon
# 主模型不可用时依次尝试（逗号分隔）
LLM_FALLBACK_MODELS=gemini-2.5-flash,gemini-3.8-flash

# ─── 随喜 / 长明灯收款码（二选一：收款码内容 或 收款码图片地址）───
# TIP_WECHAT_URL=wxp://f2f0xxxxxxxx
# TIP_ALIPAY_URL=https://qr.alipay.com/xxxxxxxx
# TIP_WECHAT_IMAGE=/pay/wechat.png
# TIP_ALIPAY_IMAGE=/pay/alipay.png
